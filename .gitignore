dist/
build/
*.egg-info/

# The bundled local model (400MB+). Fetched by `npm run models:fetch`,
# never committed; release builds download it before packaging.
apps/desktop/resources/models/

# The first-boot provisioning mirror. Two weights, 9.04 GiB, fetched once by
# `node tools/fetch-first-boot-mirror.mjs` and verified against the catalog's
# sha256 as they arrive. Disposable: deleting it costs one refetch, and
# tools/check-first-boot.mjs names the script when it is missing rather than
# reporting a pass it did not achieve.
tmp/first-boot-mirror/

# Node / TypeScript
node_modules/
*.tsbuildinfo
.vite/
coverage/
apps/*/out/
apps/*/dist/
apps/*/*.vsix
apps/*/release/
apps/*/android/
apps/*/www/

# Bundled renderer output. index.html and styles.css are source; the
# JavaScript bundle is generated by esbuild and must not be committed.
renderer/renderer.js

# The Monaco editor worker, bundled from node_modules at build time by
# `npm run build:worker`. Generated, half a megabyte, and goes stale
# whenever monaco-editor is upgraded, so it is rebuilt rather than tracked.
apps/desktop/src/ide/editor.worker.txt

apps/desktop/renderer/renderer.js
apps/desktop/renderer/renderer.js.map

# Monaco's styles, collected from the ESM build's CSS imports by
# esbuild during build:renderer. Generated, linked from index.html,
# rebuilt rather than tracked - same rule as the JavaScript bundle.
apps/desktop/renderer/renderer.css

