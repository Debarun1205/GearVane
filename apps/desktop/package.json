{
  "name": "gearvane-app",
  "productName": "GearVane",
  "version": "0.3.0",
  "description": "Route each prompt to the cheapest model tier that can do the job",
  "author": {
    "name": "Debarun1205",
    "email": "debarunbanerjee1205@gmail.com"
  },
  "homepage": "https://github.com/Debarun1205/GearVane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debarun1205/GearVane.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json && node scripts/copy-preload.mjs",
    "build:worker": "esbuild ../../node_modules/monaco-editor/esm/vs/editor/editor.worker.js --bundle --format=iife --platform=browser --target=es2022 --minify --outfile=src/ide/editor.worker.txt",
    "build:renderer": "npm run build:worker && esbuild src/renderer.ts --bundle --format=esm --target=es2022 --platform=browser --external:node:* --loader:.txt=text --loader:.ttf=dataurl --minify --outfile=renderer/renderer.js",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint src",
    "models:fetch": "node scripts/fetch-model.mjs",
    "models:fetch:first-boot": "node scripts/fetch-model.mjs --first-boot",
    "models:fetch:all": "node scripts/fetch-model.mjs --all",
    "start": "npm run build && electron dist/main.js",
    "dist": "npm run build && npm run models:fetch && electron-builder",
    "dist:linux": "npm run build && npm run models:fetch && electron-builder --linux",
    "dist:win": "npm run build && npm run models:fetch && electron-builder --win",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "clean": "rm -rf dist release out android/app/build"
  },
  "dependencies": {
    "@gearvane/app-core": "0.3.0",
    "@gearvane/core": "0.3.0",
    "@gearvane/harness": "0.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2",
    "node-llama-cpp": "3.22.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.gearvane.app",
    "productName": "GearVane",
    "electronVersion": "44.5.1",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/models/SmolLM2-360M-Instruct.Q4_K_M.gguf",
        "to": "models"
      },
      {
        "from": "resources/models/qwen2.5-coder-0.5b-instruct-q4_0.gguf",
        "to": "models"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
