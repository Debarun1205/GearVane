{
  "name": "gearvane",
  "displayName": "GearVane",
  "description": "Route each task to the cheapest model tier that can do the job",
  "version": "0.3.0",
  "publisher": "gearvane",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "llm",
    "routing",
    "model selection",
    "ollama",
    "openai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "gearvane.routeSelection",
        "title": "GearVane: Route Selection",
        "category": "GearVane"
      },
      {
        "command": "gearvane.explainSelection",
        "title": "GearVane: Explain Routing Decision",
        "category": "GearVane"
      },
      {
        "command": "gearvane.ask",
        "title": "GearVane: Ask",
        "category": "GearVane"
      },
      {
        "command": "gearvane.agent",
        "title": "GearVane: Open Agent Panel",
        "category": "GearVane"
      },
      {
        "command": "gearvane.health",
        "title": "GearVane: Check Model Health",
        "category": "GearVane"
      },
      {
        "command": "gearvane.spend",
        "title": "GearVane: Show Spend",
        "category": "GearVane"
      },
      {
        "command": "gearvane.showLog",
        "title": "GearVane: Show Routing Log",
        "category": "GearVane"
      },
      {
        "command": "gearvane.pinModel",
        "title": "GearVane: Pin Model for Workspace",
        "category": "GearVane"
      },
      {
        "command": "gearvane.clearPin",
        "title": "GearVane: Clear Pinned Model",
        "category": "GearVane"
      }
    ],
    "configuration": {
      "title": "GearVane",
      "properties": {
        "gearvane.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to a GearVane config file. Leave empty to search upward."
        },
        "gearvane.tier": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "mid",
            "frontier"
          ],
          "default": "auto",
          "description": "Force a model tier, or leave on auto to classify each request."
        },
        "gearvane.model": {
          "type": "string",
          "default": "",
          "description": "Pin a specific model, e.g. anthropic/claude-sonnet-4-20250514."
        },
        "gearvane.includeSelectionInPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Include the selected text when routing a task."
        },
        "gearvane.maxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Maximum tokens per request."
        },
        "gearvane.showRoutingNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification with the chosen tier for each request."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "gearvane.session",
          "name": "GearVane"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "@gearvane/core": "0.3.0",
    "@gearvane/harness": "0.3.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0"
  },
  "keybindings": [
    {
      "command": "gearvane.agent",
      "key": "ctrl+alt+w",
      "mac": "cmd+alt+w"
    }
  ]
}
