# Line endings.
#
# Generated artifacts are compared byte-for-byte by their `--check` modes, and
# they are written with LF. Without this, git checks them out with CRLF on
# Windows, the comparison fails against a file that is textually current, and
# the fix a contributor reaches for - regenerate, commit the noise - makes the
# repository worse on every platform.
#
# `eol=lf` fixes the working-tree form rather than only the stored form, so the
# artifact is LF everywhere it is checked out.

# Generated by tools/, and drift-checked in CI.
site/assets/catalog-data.js  eol=lf
site/assets/engine.js        eol=lf

# Generator-owned tables inside a prose file. Whole file pinned, because the
# generator rewrites blocks in place and a mixed file is otherwise inevitable on
# a Windows checkout.
README.md                    eol=lf

# Everything else: text in, LF in the index, native endings in the working tree.
# This is git's default text handling stated explicitly, which matters here
# because there was no .gitattributes at all.
* text=auto

# Binary. Never let git try to normalise these - the weights are gigabytes and
# the packaging inputs are already compressed or compiled.
*.gguf      binary
*.exe       binary
*.dmg       binary
*.zip       binary
*.vsix      binary
*.apk       binary
*.deb       binary
*.woff      binary
*.woff2     binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary