{
  "name": "@waypoint/harness",
  "version": "0.3.0",
  "description": "Agent loop, tool execution, and workspace containment",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder-node-fs": {
      "types": "./dist/builder/node-fs.d.ts",
      "import": "./dist/builder/node-fs.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "clean": "tsc --build tsconfig.json --clean && rm -rf dist"
  },
  "dependencies": {
    "@waypoint/core": "0.3.0"
  }
}